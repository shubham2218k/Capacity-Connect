# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/capacityconnect
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/capacityconnect
MONGODB_URI=

# ── JWT ────────────────────────────────────────────────────────────────────
# Generate a long random secret — e.g.: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────────────────────
# URL of the frontend (Vite dev server or production build)
CLIENT_URL=http://localhost:5173
